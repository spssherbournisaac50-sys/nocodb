{
  "name": "quickdrop",
  "version": "1.0.0",
  "private": true,
  "description": "Free, instant, no-sign-up file and text transfer between any devices using a QR code or a six-digit code.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --experimental-sqlite --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --experimental-sqlite --disable-warning=ExperimentalWarning --watch server/index.js",
    "test": "node --experimental-sqlite --disable-warning=ExperimentalWarning --test test/unit.test.js test/api.test.js",
    "test:e2e": "node --experimental-sqlite --disable-warning=ExperimentalWarning --test --test-concurrency=1 test/e2e.test.js"
  },
  "dependencies": {
    "jsqr": "1.4.0",
    "qrcode-generator": "2.0.4",
    "ws": "8.22.1"
  }
}
